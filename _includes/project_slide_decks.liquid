{% if page.presentations and page.presentations != empty %}
  <section class="project-presentations mt-5">
    <h2>Presentation Slides</h2>

    {% for deck in page.presentations %}
      <div class="project-slide-deck mt-4 mb-5">
        <h3>{{ deck.title }}</h3>

        {% if deck.venue or deck.year %}
          <p class="text-muted">
            {% if deck.venue %}{{ deck.venue }}{% endif %}
            {% if deck.venue and deck.year %} · {% endif %}
            {% if deck.year %}{{ deck.year }}{% endif %}
          </p>
        {% endif %}

        {% if deck.slides and deck.slides != empty or deck.slide_count and deck.slide_dir %}
          <swiper-container
            navigation="true"
            pagination="true"
            pagination-clickable="true"
            keyboard="true"
            space-between="16"
            slides-per-view="1"
            auto-height="true"
          >
            {% for slide in deck.slides %}
              <swiper-slide>
                {% include figure.liquid
                  path=slide.path
                  alt=slide.alt
                  caption=slide.caption
                  class="img-fluid rounded z-depth-1"
                  loading="lazy"
                %}
              </swiper-slide>
            {% endfor %}

            {% if deck.slide_count and deck.slide_dir %}
              {% assign slide_extension = deck.slide_ext | default: 'png' %}
              {% for slide_number in (1..deck.slide_count) %}
                {% if slide_number < 10 %}
                  {% assign slide_filename = 'slide-0' | append: slide_number | append: '.' | append: slide_extension %}
                {% else %}
                  {% assign slide_filename = 'slide-' | append: slide_number | append: '.' | append: slide_extension %}
                {% endif %}
                {% assign slide_path = deck.slide_dir | append: '/' | append: slide_filename %}

                <swiper-slide>
                  {% capture slide_alt %}{{ deck.title }} — slide {{ slide_number }}{% endcapture %}
                  {% include figure.liquid
                    path=slide_path
                    alt=slide_alt
                    class="img-fluid rounded z-depth-1"
                    loading="lazy"
                  %}
                </swiper-slide>
              {% endfor %}
            {% endif %}
          </swiper-container>
        {% endif %}

        {% if deck.pdf %}
          <p class="mt-3">
            <a href="{{ deck.pdf | relative_url }}" class="btn btn-sm z-depth-0" role="button">View Full Presentation (PDF)</a>
          </p>
        {% endif %}
      </div>
    {% endfor %}
  </section>
{% endif %}
